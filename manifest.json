{
  "manifest_version": 3,
  "name": "WeBWorKMAX",
  "version": "1.0.5",
  "description": "Safer collaborative grading tools for WeBWorK Manual Grader pages.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "WeBWorKMAX Extension"
  },
  "permissions": ["activeTab", "storage", "alarms"],
  "host_permissions": [
    "https://webwork2.charlotte.edu/*",
    "https://webwork3.charlotte.edu/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://webwork2.charlotte.edu/*",
        "https://webwork3.charlotte.edu/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}